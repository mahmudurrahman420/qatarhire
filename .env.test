NODE_ENV=test
# existing tests cover the verification gate; social/auth specs toggle it per test
EMAIL_VERIFICATION_REQUIRED=true
SESSION_DRIVER=memory
DB_CONNECTION=sqlite
LIMITER_STORE=memory
MAIL_MAILER=log
QUEUE_DRIVER=sync
# fake social credentials so the Google/LinkedIn buttons and redirects can be tested (never real values)
GOOGLE_CLIENT_ID=test-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-google-secret
LINKEDIN_CLIENT_ID=test-linkedin-client-id
LINKEDIN_CLIENT_SECRET=test-linkedin-secret
