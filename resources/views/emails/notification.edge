@component('components/email_layout', { subject, appName, appUrl })
  <p style="margin:0 0 14px;">Hi {{ name }},</p>
  <p style="margin:0 0 12px;font-size:17px;font-weight:bold;">{{ title }}</p>
  @if(body)
    <p style="margin:0 0 20px;white-space:pre-line;">{{ body }}</p>
  @end
  @if(url)
    <p style="margin:0;"><a href="{{ appUrl }}{{ url }}" style="display:inline-block;background:#6d1631;color:#ffffff;text-decoration:none;padding:11px 20px;border-radius:8px;font-weight:bold;">View on {{ appName }}</a></p>
  @end
@end
