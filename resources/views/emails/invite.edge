@component('components/email_layout', { subject, appName, appUrl })
  <p style="margin:0 0 14px;">Hi {{ name }},</p>
  <p style="margin:0 0 20px;">{{ inviter }} invited you to join <strong>{{ companyName }}</strong> on {{ appName }} as a recruiter.</p>
  <p style="margin:0 0 24px;"><a href="{{ url }}" style="display:inline-block;background:#0b7a3c;color:#ffffff;text-decoration:none;padding:12px 22px;border-radius:8px;font-weight:bold;">Accept invitation</a></p>
  <p style="margin:0;font-size:13px;color:#5b6478;">The invitation expires in 7 days.</p>
@end
