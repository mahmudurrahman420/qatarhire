@component('components/email_layout', { subject, appName, appUrl })
  <p style="margin:0 0 14px;">Hi {{ name }},</p>
  <p style="margin:0 0 20px;">We received a request to reset your password.</p>
  <p style="margin:0 0 24px;"><a href="{{ url }}" style="display:inline-block;background:#0b7a3c;color:#ffffff;text-decoration:none;padding:12px 22px;border-radius:8px;font-weight:bold;">Choose a new password</a></p>
  <p style="margin:0;font-size:13px;color:#5b6478;">This link expires in 60 minutes and can be used once. If you didn't ask for this, no action is needed — your password stays the same.</p>
@end
