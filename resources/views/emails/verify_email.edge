@component('components/email_layout', { subject, appName, appUrl })
  <p style="margin:0 0 14px;">Hi {{ name }},</p>
  <p style="margin:0 0 20px;">Please confirm your email address to activate your {{ appName }} account.</p>
  <p style="margin:0 0 24px;"><a href="{{ url }}" style="display:inline-block;background:#0b7a3c;color:#ffffff;text-decoration:none;padding:12px 22px;border-radius:8px;font-weight:bold;">Confirm email</a></p>
  <p style="margin:0;font-size:13px;color:#5b6478;">This link expires in 48 hours. If you did not create an account, you can ignore this email.<br>{{ url }}</p>
@end
