<!DOCTYPE html>
<html lang="{{ page.props.locale?.code ?? 'en' }}" dir="{{ page.props.locale?.dir ?? 'ltr' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0B7A3C">
  {{-- Server-rendered meta so crawlers get titles, descriptions and JobPosting data without running JS --}}
  <title inertia>{{ page.props.meta?.title ? page.props.meta.title + ' | ' + page.props.appName : page.props.appName + ' — Get discovered by Gulf employers' }}</title>
  @if(page.props.meta?.description)
    <meta inertia name="description" content="{{ page.props.meta.description }}">
  @end
  @if(page.props.canonical)
    <link rel="canonical" href="{{ page.props.canonical }}">
  @end
  @if(page.props.meta?.noindex)
    <meta name="robots" content="noindex">
  @end
  @if(page.props.structuredData)
    <script type="application/ld+json" nonce="{{ cspNonce }}">{{{ JSON.stringify(page.props.structuredData).replace(/</g, '\\u003c') }}}</script>
  @end
  <link rel="icon" href="/favicon.png" type="image/png">
  @viteReactRefresh()
  @inertiaHead()
  @vite(['inertia/app/app.tsx', `inertia/pages/${page.component}.tsx`])
</head>
<body>
  @inertia()
</body>
</html>
