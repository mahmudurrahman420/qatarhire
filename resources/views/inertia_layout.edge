<!DOCTYPE html>
<html lang="{{ page.props.locale?.code ?? 'en' }}" dir="{{ page.props.locale?.dir ?? 'ltr' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#8A1538">
  {{-- Server-rendered meta so crawlers get titles, descriptions and JobPosting data without running JS --}}
  <title inertia>{{ page.props.meta?.title ? page.props.meta.title + ' | ' + page.props.appName : page.props.appName + ' — Jobs in Qatar' }}</title>
  @if(page.props.meta?.description)
    <meta inertia name="description" content="{{ page.props.meta.description }}">
  @end
  @if(page.props.canonical)
    <link rel="canonical" href="{{ page.props.canonical }}">
  @end
  @if(page.props.meta?.noindex)
    <meta name="robots" content="noindex">
  @end
  @if(page.props.structuredData)
    <script type="application/ld+json" nonce="{{ cspNonce }}">{{{ JSON.stringify(page.props.structuredData).replace(/</g, '\\u003c') }}}</script>
  @end
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans+Arabic:wght@400;600&display=swap" rel="stylesheet">
  @viteReactRefresh()
  @inertiaHead()
  @vite(['inertia/app/app.tsx', `inertia/pages/${page.component}.tsx`])
</head>
<body>
  @inertia()
</body>
</html>
