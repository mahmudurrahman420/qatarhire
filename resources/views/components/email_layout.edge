<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f5f2ee;font-family:Arial,Helvetica,sans-serif;color:#1f1a17;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f2ee;padding:24px 12px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e7e0d8;">
        <tr><td style="background:#6d1631;padding:18px 28px;">
          <span style="color:#ffffff;font-size:18px;font-weight:bold;letter-spacing:.3px;">{{ appName }}</span>
        </td></tr>
        <tr><td style="padding:28px;font-size:15px;line-height:1.6;">
          {{{ await $slots.main() }}}
        </td></tr>
        <tr><td style="padding:18px 28px;border-top:1px solid #efe9e2;font-size:12px;color:#7a6f66;line-height:1.5;">
          You received this email because of activity on your {{ appName }} account.
          Manage email preferences in <a href="{{ appUrl }}/account" style="color:#6d1631;">account settings</a>.
          {{ appName }} never asks candidates to pay for job applications or visas.
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
