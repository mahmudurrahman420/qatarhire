<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f3f6f8;font-family:Arial,Helvetica,sans-serif;color:#222a3f;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f6f8;padding:24px 12px;">
    <tr><td align="center">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e2e5ec;">
        <tr><td style="background:#0b7a3c;padding:18px 28px;">
          <span style="color:#ffffff;font-size:18px;font-weight:bold;letter-spacing:.3px;">hiremegulf.com</span>
        </td></tr>
        <tr><td style="padding:28px;font-size:15px;line-height:1.6;">
          {{{ await $slots.main() }}}
        </td></tr>
        <tr><td style="padding:18px 28px;border-top:1px solid #e8ebf0;font-size:12px;color:#5b6478;line-height:1.5;">
          You received this email because of activity on your {{ appName }} account.
          Manage email preferences in <a href="{{ appUrl }}/account" style="color:#0b7a3c;">account settings</a>.
          hiremegulf.com is free for jobseekers. Real employers never ask you to pay for a job or visa.
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
