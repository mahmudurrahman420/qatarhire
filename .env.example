# Copy to .env and fill in. Never commit .env.
TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
# Generate with: node ace generate:key
APP_KEY=
APP_NAME=QatarHire
APP_URL=http://localhost:3333
NODE_ENV=development

SESSION_DRIVER=cookie

# sqlite (local) or mysql (production)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=qatarhire
DB_PASSWORD=
DB_DATABASE=qatarhire

# log (dev: writes previews to storage/mail-previews) or smtp
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@qatarhire.local
MAIL_FROM_NAME=QatarHire
# Where contact-form messages are delivered
SUPPORT_EMAIL=support@qatarhire.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false

# sync (dev) or database (production, run `node ace queue:work`)
QUEUE_DRIVER=sync

# memory (single process / dev) or database (production)
LIMITER_STORE=memory

DRIVE_DISK=public
CV_MAX_SIZE_MB=5

# Optional: ClamAV daemon for CV malware scanning
CLAMAV_HOST=
CLAMAV_PORT=3310